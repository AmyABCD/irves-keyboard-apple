<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE keyboard SYSTEM "file://localhost/System/Library/DTDs/KeyboardLayout.dtd">
<keyboard group="0" id="-19985" name="Ирвэс Монгол" maxout="1">
    <layouts>
        <layout first="0" last="0" modifiers="modifiers" mapSet="default"/>
    </layouts>
    <modifierMap id="modifiers" defaultIndex="0">
        <keyMapSelect mapIndex="0">
            <modifier keys=""/>
        </keyMapSelect>
        <keyMapSelect mapIndex="1">
            <modifier keys="shift"/>
        </keyMapSelect>
        <keyMapSelect mapIndex="2">
            <modifier keys="caps"/>
        </keyMapSelect>
        <keyMapSelect mapIndex="3">
            <modifier keys="shift caps"/>
        </keyMapSelect>
        <keyMapSelect mapIndex="4">
            <modifier keys="option"/>
        </keyMapSelect>
        <keyMapSelect mapIndex="5">
            <modifier keys="shift option"/>
        </keyMapSelect>
    </modifierMap>
    <keyMapSet id="default">
        <!-- Normal lowercase -->
        <keyMap index="0">
            <key code="50" output="`"/>
            <key code="18" output="1"/>
            <key code="19" output="2"/>
            <key code="20" output="3"/>
            <key code="21" output="4"/>
            <key code="23" output="5"/>
            <key code="22" output="6"/>
            <key code="26" output="7"/>
            <key code="28" output="8"/>
            <key code="25" output="9"/>
            <key code="29" output="0"/>
            <key code="27" output="-"/>
            <key code="24" output="="/>

            <!-- Row 1: ф ц у ж э н г ш ү з к ъ -->
            <key code="12" output="ф"/>
            <key code="13" output="ц"/>
            <key code="14" output="у"/>
            <key code="15" output="ж"/>
            <key code="17" output="э"/>
            <key code="16" output="н"/>
            <key code="32" output="г"/>
            <key code="34" output="ш"/>
            <key code="31" output="ү"/>
            <key code="35" output="з"/>
            <key code="33" output="к"/>
            <key code="30" output="ъ"/>
            <key code="42" output="\"/>

            <!-- Row 2: й ы б ө а х р о л д п -->
            <key code="0" output="й"/>
            <key code="1" output="ы"/>
            <key code="2" output="б"/>
            <key code="3" output="ө"/>
            <key code="5" output="а"/>
            <key code="4" output="х"/>
            <key code="38" output="р"/>
            <key code="40" output="о"/>
            <key code="37" output="л"/>
            <key code="41" output="д"/>
            <key code="39" output="п"/>

            <!-- Row 3: я ч ё с м и т ь в ю -->
            <key code="6" output="я"/>
            <key code="7" output="ч"/>
            <key code="8" output="ё"/>
            <key code="9" output="с"/>
            <key code="11" output="м"/>
            <key code="45" output="и"/>
            <key code="46" output="т"/>
            <key code="43" output="ь"/>
            <key code="47" output="в"/>
            <key code="44" output="ю"/>

            <key code="49" output=" "/>
        </keyMap>

        <!-- Shift uppercase -->
        <keyMap index="1">
            <key code="50" output="~"/>
            <key code="18" output="!"/>
            <key code="19" output="&quot;"/>
            <key code="20" output="№"/>
            <key code="21" output="₮"/>
            <key code="23" output=":"/>
            <key code="22" output="."/>
            <key code="26" output=","/>
            <key code="28" output="%"/>
            <key code="25" output="?"/>
            <key code="29" output=";"/>
            <key code="27" output="_"/>
            <key code="24" output="+"/>

            <!-- Row 1: Ф Ц У Ж Э Н Г Ш Ү З К Ъ -->
            <key code="12" output="Ф"/>
            <key code="13" output="Ц"/>
            <key code="14" output="У"/>
